modules = ["nodejs-20", "web", "python-3.11"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Arabic Landing Page Server"

[[workflows.workflow]]
name = "Arabic Landing Page Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m http.server 5000"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "python3 -m http.server 5000"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 37315
externalPort = 3001

[[ports]]
localPort = 43287
externalPort = 3000

[[ports]]
localPort = 45753
externalPort = 3002

[agent]
expertMode = true
